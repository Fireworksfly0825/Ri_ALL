# GitHub 账号隔离：同一台机器上多把 key 分别对应不同账号。
# 默认的 id_rsa 认证出来是 JhonZ-Dev，lemonade052 走下面的别名，
# Fireworksfly0825 走 github-fireworksfly。
Host github-lemonade
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_lemonade052
    IdentitiesOnly yes

Host github-fireworksfly
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_fireworksfly0825
    IdentitiesOnly yes

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_rsa
    IdentitiesOnly yes
